#!/bin/bash

# omagtd-app is a compatibility CLI name: it routes to OmaGTD's overlay in
# the already-running Omarchy shell and never starts a Quickshell process.
set -euo pipefail

TARGET="com.auino.omagtd"

case "${1:-}" in
  view)
    payload="$(python3 -c 'import json,sys; print(json.dumps({"action":"view","name":sys.argv[1]}))' "${2:-today}")"
    exec omarchy-shell shell summon "$TARGET" "$payload"
    ;;
  open-item)
    payload="$(python3 -c 'import json,sys; print(json.dumps({"action":"openItem","id":sys.argv[1]}))' "${2:?item id required}")"
    exec omarchy-shell shell summon "$TARGET" "$payload"
    ;;
  edit-item)
    payload="$(python3 -c 'import json,sys; print(json.dumps({"action":"editItem","id":sys.argv[1]}))' "${2:?item id required}")"
    exec omarchy-shell shell summon "$TARGET" "$payload"
    ;;
  quit|close)
    exec omarchy-shell shell hide "$TARGET"
    ;;
  toggle)
    exec omarchy-shell shell toggle "$TARGET" '{}'
    ;;
  *)
    exec omarchy-shell shell summon "$TARGET" '{}'
    ;;
esac
