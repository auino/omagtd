#!/usr/bin/env python3
"""`gtd` — the command line for the GTD Omarchy plugin.

Kept to a shim on purpose: the plugin directory is the single source of truth,
so a clone, an update or a `gtd` symlink in ~/.local/bin all run the same
code. Python 3 with the standard library is the only requirement.
"""

import os
import sys

PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(PLUGIN_DIR, "lib"))

if sys.version_info < (3, 10):  # the code uses match-free 3.10+ syntax only
    sys.exit("gtd needs Python 3.10 or newer")

from gtd.cli import main  # noqa: E402  (path set up above)

if __name__ == "__main__":
    sys.exit(main())
